#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>; /* Chống dính phím Command/Shift/Ctrl/Alt khi gõ lướt */
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Layout Colemak với Home Row Mods
            bindings = <
&kp TAB   &kp Q       &kp W       &kp F      &kp P      &kp G   &kp J &kp L      &kp U      &kp Y       &kp SEMI    &kp BSPC
&kp LSHFT &hm LSHFT A &hm LCTRL R &hm LALT S &hm LGUI T &kp D   &kp H &hm RGUI N &hm RALT E &hm RCTRL I &hm RSHFT O &kp SQT
&kp LCTRL &kp Z       &kp X       &kp C      &kp V      &kp B   &kp K &kp M      &kp COMMA  &kp DOT     &kp FSLH    &kp ESC
                      &kp LGUI    &kp RET    &kp SPACE          &kp SPACE &kp RET &kp RALT
            >;
        };
    };
};
